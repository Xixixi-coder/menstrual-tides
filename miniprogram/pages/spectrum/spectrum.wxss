.container {
  min-height: 100vh;
  background: #0A1628;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
}

.label {
  font-size: 24rpx;
  opacity: 0.35;
  letter-spacing: 3rpx;
  margin-bottom: 48rpx;
}

.track {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6rpx;
  margin-bottom: 60rpx;
  max-width: 600rpx;
}

.dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  opacity: 0.5;
  transition: all 300ms;
}

.dot.active {
  width: 24rpx; height: 24rpx;
  opacity: 1;
  box-shadow: 0 0 12rpx currentColor;
}

.day-info {
  text-align: center;
  margin-bottom: 24rpx;
}

.day-num {
  display: block;
  font-size: 60rpx;
  font-weight: 300;
  margin-bottom: 12rpx;
}

.phase-name {
  font-size: 28rpx;
  opacity: 0.6;
  letter-spacing: 2rpx;
}

.poem {
  font-size: 28rpx;
  line-height: 1.8;
  opacity: 0.6;
  font-weight: 300;
  max-width: 560rpx;
  text-align: center;
  margin-bottom: 36rpx;
}

.tips-section {
  max-width: 560rpx;
  width: 100%;
  margin-bottom: 48rpx;
}

.tip-row {
  margin-bottom: 20rpx;
}

.tip-row:last-child { margin-bottom: 0; }

.tip-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(192, 197, 206, 0.08);
  color: #C0C5CE;
  opacity: 0.7;
  margin-right: 10rpx;
  vertical-align: middle;
}

.tip-text {
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.45;
  font-weight: 300;
}

.nav {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.nav-btn {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(192, 197, 206, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #F5F5F0;
}

.nav-btn.disabled {
  opacity: 0.15;
}

.progress {
  font-size: 24rpx;
  opacity: 0.3;
  letter-spacing: 2rpx;
}

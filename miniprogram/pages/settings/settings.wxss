.container {
  min-height: 100vh;
  background: #0A1628;
  padding: 120rpx 48rpx 60rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 300;
  margin-bottom: 60rpx;
  letter-spacing: 4rpx;
}

.section {
  margin-bottom: 48rpx;
  padding: 32rpx;
  background: rgba(15, 32, 53, 0.4);
  border-radius: 24rpx;
  border: 1rpx solid rgba(192, 197, 206, 0.06);
}

.section-title {
  display: block;
  font-size: 26rpx;
  opacity: 0.5;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.hint {
  font-size: 22rpx;
  opacity: 0.35;
  margin-top: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(192, 197, 206, 0.05);
}

.info-label {
  font-size: 26rpx;
  opacity: 0.5;
}

.info-value {
  font-size: 26rpx;
  opacity: 0.7;
}

.reset-btn {
  background: transparent;
  border: 1rpx solid rgba(192, 197, 206, 0.12);
  color: #F5F5F0;
  font-size: 26rpx;
  opacity: 0.5;
  border-radius: 48rpx;
  padding: 20rpx 40rpx;
  margin-top: 20rpx;
}

.footer {
  text-align: center;
  margin-top: 100rpx;
}

.footer-text {
  display: block;
  font-size: 24rpx;
  opacity: 0.25;
  font-style: italic;
  margin-bottom: 12rpx;
}

.footer-sub {
  display: block;
  font-size: 20rpx;
  opacity: 0.15;
  letter-spacing: 2rpx;
}

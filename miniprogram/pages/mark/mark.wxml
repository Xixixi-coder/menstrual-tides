<view class="container">
  <text class="header">今天的身体感觉：</text>

  <view class="tags">
    <view wx:for="{{emotions}}" wx:key="*this"
      class="tag {{selectedEmotion === item ? 'selected' : ''}}"
      data-emotion="{{item}}" bindtap="selectEmotion">
      {{item}}
    </view>
  </view>

  <view class="period-area">
    <button class="period-btn {{inPeriod ? 'active' : ''}}" bindtap="markPeriodStart" wx:if="{{!inPeriod}}">🔴 经期开始</button>
    <button class="period-btn" bindtap="markPeriodEnd" wx:if="{{inPeriod}}">经期结束</button>
  </view>

  <text class="poem-hint" wx:if="{{poemHint}}">{{poemHint}}</text>

  <input class="text-input" placeholder="想留下一句话吗？（可选）"
    maxlength="50" value="{{text}}" bindinput="onTextInput" />

  <button class="submit-btn" disabled="{{!selectedEmotion}}" bindtap="submit">汇入潮汐</button>
</view>

.container {
  min-height: 100vh;
  background: #0A1628;
  padding: 120rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  font-size: 32rpx;
  opacity: 0.7;
  margin-bottom: 40rpx;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 18rpx;
  margin-bottom: 32rpx;
}

.tag {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(192, 197, 206, 0.15);
  background: transparent;
  color: #F5F5F0;
  font-size: 28rpx;
}

.tag.selected {
  background: rgba(232, 165, 152, 0.15);
  border-color: #E8A598;
  color: #E8A598;
}

.period-area {
  margin-bottom: 24rpx;
}

.period-btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(199, 62, 58, 0.3);
  background: transparent;
  color: #E8A598;
  font-size: 26rpx;
}

.period-btn.active {
  background: rgba(199, 62, 58, 0.2);
  border-color: #E8A598;
}

.poem-hint {
  font-size: 26rpx;
  opacity: 0.4;
  margin-bottom: 32rpx;
  font-style: italic;
  letter-spacing: 2rpx;
}

.text-input {
  width: 80%;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(192, 197, 206, 0.1);
  background: rgba(15, 32, 53, 0.5);
  color: #F5F5F0;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.submit-btn {
  padding: 24rpx 72rpx;
  border-radius: 48rpx;
  border: none;
  background: linear-gradient(135deg, rgba(30, 58, 95, 0.8), rgba(123, 109, 141, 0.6));
  color: #F5F5F0;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.submit-btn[disabled] {
  opacity: 0.3;
}

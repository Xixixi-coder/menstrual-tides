.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.tide-canvas {
  position: fixed;
  top: 0; left: 0;
  z-index: 0;
}

.moon-area {
  position: fixed;
  top: 60rpx; right: 48rpx;
  text-align: right;
  z-index: 10;
}

.moon-icon {
  font-size: 64rpx;
  display: block;
}

.moon-label {
  font-size: 22rpx;
  opacity: 0.45;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.phase-area {
  position: fixed;
  top: 280rpx;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  width: 80%;
  z-index: 10;
}

.phase-today {
  display: block;
  font-size: 28rpx;
  opacity: 0.7;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.phase-poem {
  display: block;
  font-size: 26rpx;
  opacity: 0.5;
  line-height: 1.7;
  font-weight: 300;
}

.bottom-actions {
  position: fixed;
  bottom: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 10;
}

.mark-btn {
  background: rgba(10, 22, 40, 0.55);
  border: 1rpx solid rgba(192, 197, 206, 0.12);
  border-radius: 48rpx;
  padding: 24rpx 56rpx;
  color: #F5F5F0;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.wave-icon {
  display: inline;
  margin-right: 4rpx;
}

.cycle-label {
  font-size: 22rpx;
  opacity: 0.3;
  letter-spacing: 2rpx;
}

.setup-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6, 13, 24, 0.85);
}

.setup-card {
  width: 85%;
  max-width: 680rpx;
  padding: 64rpx 48rpx;
  background: rgba(10, 22, 40, 0.9);
  border: 1rpx solid rgba(192, 197, 206, 0.1);
  border-radius: 40rpx;
  text-align: center;
}

.setup-title {
  display: block;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.setup-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.4;
  margin-bottom: 40rpx;
}

.setup-date-btn {
  padding: 20rpx 32rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(192, 197, 206, 0.15);
  background: rgba(15, 32, 53, 0.6);
  color: #F5F5F0;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.setup-skip-btn {
  background: transparent;
  border: 1rpx solid rgba(192, 197, 206, 0.15);
  color: #F5F5F0;
  font-size: 28rpx;
  opacity: 0.5;
  border-radius: 48rpx;
  padding: 20rpx 40rpx;
}
